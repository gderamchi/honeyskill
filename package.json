{
  "name": "@gderamchi/skillgate",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "tsx apps/cli/src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "playwright test",
    "benchmark": "tsx packages/skillguard-lite/src/main.ts benchmark",
    "benchmark:behavioral": "tsx packages/skillguard-lite/src/main.ts benchmark-behavioral",
    "demo": "tsx packages/demo/src/run.ts",
    "pack:local": "node scripts/pack.mjs",
    "smoke:package": "node scripts/smoke-package.mjs",
    "prepare:demo": "node scripts/prepare-demo.mjs",
    "validate": "node scripts/validate.mjs",
    "build:cli": "node scripts/build.mjs",
    "benchmark:static": "tsx evaluation/run.ts",
    "audit": "tsx packages/skillguard-lite/src/main.ts audit",
    "check:fork": "tsx packages/skillguard-lite/src/main.ts check-fork",
    "test:behavioral": "tsx --test packages/skillguard-lite/tests/*.test.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "commander": "15.0.0",
    "esbuild": "0.28.2",
    "openai": "7.32.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "viem": "^2.57.4",
    "vite": "8.3.4",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "bin": {
    "skillgate": "dist/cli.js"
  },
  "files": [
    "dist"
  ]
}
